generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum TransactionType {
  INITIAL_COUNT
  RECEIVING
  SALE_CONSUMPTION
  WASTE
  MANUAL_ADJUSTMENT
  PHYSICAL_COUNT
  TRANSFER_IN
  TRANSFER_OUT
}
enum TransactionSource {
  USER
  TOAST
  AI_PHOTO
  INVOICE
  SYSTEM
}
enum ProcessingStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}
enum BottleStatus {
  FULL
  OPEN
  EMPTY
  DISCARDED
}
enum CountSessionStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  FINALIZED
  VOIDED
}
enum CountMethod {
  MANUAL
  PHOTO_ASSISTED
  IMPORTED
}
enum UserRole {
  MANAGER
  STAFF
}
model Organization {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  locations Location[]
}
model User {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  email String @unique
  name String
  passwordHash String
  role UserRole @default(MANAGER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Location {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  name String
  address String @default("")
  varianceThreshold Decimal @default(10) @db.Decimal(8, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
  bottles Bottle[]
  transactions InventoryTransaction[]
  menuItems MenuItem[]
  imports ToastImport[]
  sales Sale[]
  photos Photo[]
  physicalCounts PhysicalCount[]
  countSessions CountSession[]
  invoices Invoice[]
  aliases ProductAlias[]
}
model Product {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  name String
  normalizedName String
  category String
  brand String
  bottleSizeMl Decimal @db.Decimal(12, 4)
  bottleSizeOz Decimal @db.Decimal(12, 4)
  unitCost Decimal @db.Decimal(12, 4)
  parLevel Decimal @default(2) @db.Decimal(12, 4)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bottles Bottle[]
  transactions InventoryTransaction[]
  ingredients RecipeIngredient[]
  physicalCounts PhysicalCount[]
  countSessionLines CountSessionLine[]
  countSessionCorrections CountSessionCorrection[]
  aliases ProductAlias[]
  @@unique([locationId, normalizedName, bottleSizeMl])
}
model Bottle {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  bottleSizeMl Decimal @db.Decimal(12, 4)
  receivedAt DateTime @default(now())
  openedAt DateTime?
  status BottleStatus @default(FULL)
  currentEstimatedFillPercent Decimal? @db.Decimal(8, 4)
  currentEstimatedVolumeMl Decimal? @db.Decimal(14, 4)
  lastPhotoId String?
}
model InventoryTransaction {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  type TransactionType
  quantityBottles Decimal @db.Decimal(18, 6)
  quantityMl Decimal @db.Decimal(18, 6)
  unitCost Decimal @db.Decimal(12, 4)
  source TransactionSource
  sourceId String?
  notes String @default("")
  createdAt DateTime @default(now())
  createdBy String
  idempotencyKey String? @unique
  @@index([locationId, productId, createdAt])
}
model MenuItem {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  name String
  toastItemId String?
  category String @default("Cocktails")
  createdAt DateTime @default(now())
  recipe Recipe?
  sales Sale[]
  @@unique([locationId, name])
  @@unique([locationId, toastItemId])
}
model Recipe {
  id String @id @default(cuid())
  menuItemId String @unique
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  name String
  servings Decimal @default(1) @db.Decimal(12, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ingredients RecipeIngredient[]
}
model RecipeIngredient {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Decimal @db.Decimal(12, 4)
  unit String
}
model ToastImport {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  kind String
  filename String
  hash String
  mapping Json
  rowCount Int
  metadata Json
  createdAt DateTime @default(now())
  createdBy String
  sales Sale[]
  @@unique([locationId, kind, hash])
}
model Sale {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  menuItemId String
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  importId String
  import ToastImport @relation(fields: [importId], references: [id])
  externalId String?
  quantity Decimal @db.Decimal(12, 4)
  soldAt DateTime
  processedAt DateTime?
  @@unique([locationId, externalId])
  @@index([locationId, soldAt])
}
model Photo {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  storageKey String
  filename String
  mimeType String
  size Int
  status ProcessingStatus @default(UPLOADED)
  result Json?
  reviewedResult Json?
  error String?
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  capturedAt DateTime @default(now())
  createdBy String
  confirmedAt DateTime?
  physicalCounts PhysicalCount[]
  countSessionLines CountSessionLine[]
}
model PhysicalCount {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  photoId String?
  photo Photo? @relation(fields: [photoId], references: [id])
  countSessionId String?
  countSession CountSession? @relation(fields: [countSessionId], references: [id])
  quantityBottles Decimal @db.Decimal(18, 6)
  quantityMl Decimal @db.Decimal(18, 6)
  confidence Decimal @db.Decimal(8, 4)
  confirmedBy String
  confirmedAt DateTime @default(now())
  countedAt DateTime @default(now())
  varianceStatus String @default("REVIEW")
  varianceReviewedAt DateTime?
  varianceReviewedBy String?
  @@unique([photoId, productId])
  @@index([locationId, productId, countedAt])
}
model Invoice {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  storageKey String
  filename String
  mimeType String
  hash String
  vendor String?
  invoiceNumber String?
  date DateTime?
  status ProcessingStatus @default(UPLOADED)
  result Json?
  reviewedResult Json?
  error String?
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  createdBy String
  confirmedAt DateTime?
  @@unique([locationId, hash])
  @@unique([locationId, vendor, invoiceNumber])
}
model ProductAlias {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  normalizedName String
  bottleSizeMl Decimal @db.Decimal(12, 4)
  productId String
  product Product @relation(fields: [productId], references: [id])
  @@unique([locationId, normalizedName, bottleSizeMl])
}

model CountSession {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  status CountSessionStatus @default(DRAFT)
  method CountMethod @default(MANUAL)
  startedAt DateTime @default(now())
  endedAt DateTime?
  countedAt DateTime @default(now())
  notes String @default("")
  createdBy String
  reviewedBy String?
  reviewedAt DateTime?
  finalizedBy String?
  finalizedAt DateTime?
  voidedBy String?
  voidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines CountSessionLine[]
  corrections CountSessionCorrection[]
  physicalCounts PhysicalCount[]
  @@index([locationId, countedAt])
  @@index([locationId, status, updatedAt])
}

model CountSessionLine {
  id String @id @default(cuid())
  sessionId String
  session CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  photoId String?
  photo Photo? @relation(fields: [photoId], references: [id])
  quantityMl Decimal @db.Decimal(18, 6)
  quantityBottles Decimal @db.Decimal(18, 6)
  confidence Decimal @db.Decimal(8, 4)
  notes String @default("")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, productId])
  @@index([productId, updatedAt])
}

model CountSessionCorrection {
  id String @id @default(cuid())
  sessionId String
  session CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  beforeQuantityMl Decimal @db.Decimal(18, 6)
  beforeQuantityBottles Decimal @db.Decimal(18, 6)
  afterQuantityMl Decimal @db.Decimal(18, 6)
  afterQuantityBottles Decimal @db.Decimal(18, 6)
  reason String
  correctedBy String
  correctedAt DateTime @default(now())
  @@index([sessionId, correctedAt])
}